# Copy to .env and fill in. The server refuses to start without MONGODB_URI and JWT_SECRET.

# --- Required ---
MONGODB_URI=mongodb://localhost:27017/xendelta-hub
JWT_SECRET=change-me-to-a-long-random-string   # openssl rand -hex 48

# --- Server ---
PORT=3000
NODE_ENV=development
# Public base URL, no trailing slash. Used for CORS, Socket.IO and links in emails.
PUBLIC_URL=http://localhost:3000

# --- Email (password reset, notifications) ---
RESEND_API_KEY=
# --- Exchange rates (XenSplit) ---
EXCHANGERATE_API_KEY=

# --- Google Cloud Storage (uploads) ---
GCS_PUBLIC_BUCKET_NAME=
GCS_PRIVATE_BUCKET_NAME=
# Service account key file lives at ./gcs-service-account.json (gitignored)

# --- OAuth login (each optional; the matching button just won't work if unset) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=

# --- Web push ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Bugsnag (leave unset locally to stay silent) ---
BUGSNAG_API_KEY=
BUGSNAG_RELEASE_STAGE=development
VITE_BUGSNAG_API_KEY=
VITE_BUGSNAG_APP_VERSION=
VITE_BUGSNAG_RELEASE_STAGE=development

# Buying gems with money is switched off for everyone until a real provider (Stripe) is added; see
# docs/monetization.md. This setting is ignored for now.
PAYMENTS_PROVIDER=none

# --- Automatic database backups (optional; see docs/admin.md) ---
# Write a backup to the private bucket this often. Unset or 0 means no automatic backups.
BACKUP_SCHEDULE_HOURS=
# How many automatic backups to keep (older ones are deleted). Manual backups are never deleted automatically.
BACKUP_KEEP=14

# --- GIFs in chat (optional) ---
# A GIPHY API key (https://developers.giphy.com). Without it the GIF button is hidden. The key stays on the server;
# the browser only talks to /api/gifs.
GIPHY_API_KEY=
