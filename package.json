{
  "name": "xendelta-hub",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon -w src/server -x tsx src/server/server.ts",
    "start": "cross-env NODE_ENV=production tsx src/server/server.ts",
    "build": "vite build",
    "type-check": "npm run type-check:server && npm run type-check:client && npm run type-check:sw",
    "type-check:server": "tsc --noEmit --project src/server/tsconfig.json",
    "type-check:client": "tsc --noEmit --project src/client/tsconfig.json",
    "type-check:sw": "tsc --noEmit --project src/client/pwa/tsconfig.sw.json",
    "test": "vitest run",
    "db:export": "tsx scripts/db-backup.ts export",
    "db:import": "tsx scripts/db-backup.ts import",
    "db:migrate": "migrate up -f migrate.ts",
    "db:migrate:down": "migrate down -f migrate.ts",
    "db:migrate:status": "migrate list -f migrate.ts",
    "db:migrate:create": "migrate create -f migrate.ts",
    "db:migrate:prune": "migrate prune -f migrate.ts"
  },
  "dependencies": {
    "@bugsnag/js": "^8.10.0",
    "@bugsnag/plugin-express": "^8.9.0",
    "@bugsnag/plugin-react": "^8.9.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@google-cloud/storage": "^8.4.0",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/x-date-pickers": "^9.17.0",
    "@tanstack/react-query": "^5.107.1",
    "axios": "^1.21.1",
    "bcryptjs": "^3.0.3",
    "bson": "^6.10.4",
    "cors": "^2.8.6",
    "cross-env": "^7.0.3",
    "d3-force": "^3.0.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.8",
    "multer": "^2.5.0",
    "notistack": "^3.0.2",
    "papaparse": "^5.7.0",
    "passport": "^0.7.0",
    "passport-discord": "^0.1.4",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.38.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "vite-express": "^0.21.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bugsnag/source-maps": "^2.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.4.1",
    "miniature-paints": "^0.2.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2",
    "ts-migrate-mongoose": "^5.3.3",
    "typescript": "~5.9.3",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1"
  },
  "overrides": {
    "ws": "^8.22.2",
    "engine.io": "^6.6.11",
    "engine.io-client": "^6.6.8",
    "socket.io-parser": "^4.2.7",
    "socket.io-adapter": "^2.5.8",
    "path-to-regexp": "^8.4.0"
  }
}
